DEEPSEEK_API_KEY=replace-with-your-local-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MINICUT_EXPORT_CONCURRENCY=2
# Optional: explicit FFmpeg executable for rendering and cover frame extraction.
# macOS Homebrew example; Intel Macs normally use /usr/local instead.
# MINICUT_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
